@@ -193,6 +212,35 @@ static bool BaseFile_Open(TFileStream * pStream, const TCHAR * szFileName, DWORD
     }
 #endif
 
+#ifdef STORMLIB_PEOS
+    {
+        // A file opened for writing can be read as well
+        uint64_t flags = (dwStreamFlags & STREAM_FLAG_READ_ONLY) ? PEOS_O_READ : PEOS_O_WRITE;
+        peos_stat_t st;
+        uint64_t fd;
+
+        if((int64_t)peos_stat(szFileName, strlen(szFileName), &st, sizeof(st)) < 0 || st.is_dir)
+        {
+            pStream->Base.File.hFile = INVALID_HANDLE_VALUE;
+            dwLastError = ERROR_FILE_NOT_FOUND;
+            return false;
+        }
+
+        fd = peos_fopen(szFileName, strlen(szFileName), flags);
+        if((int64_t)fd < 0)
+        {
+            pStream->Base.File.hFile = INVALID_HANDLE_VALUE;
+            dwLastError = ERROR_ACCESS_DENIED;
+            return false;
+        }
+
+        // FILETIME counts 100 ns from 1601; PeOS's times are ns from 1970
+        pStream->Base.File.FileTime = 0x019DB1DED53E8000ULL + st.mtime_ns / 100;
+        pStream->Base.File.FileSize = st.size;
+        pStream->Base.File.hFile = (HANDLE)(intptr_t)fd;
+    }
+#endif
+
