+#ifdef STORMLIB_PEOS
+    {
+        uint64_t fd = (uint64_t)(intptr_t)pStream->Base.File.hFile;
+
+        if(ByteOffset != pStream->Base.File.FilePos)
+        {
+            if((int64_t)peos_fseek(fd, (size_t)ByteOffset) < 0)
+            {
+                dwLastError = ERROR_CAN_NOT_COMPLETE;
+                return false;
+            }
+            pStream->Base.File.FilePos = ByteOffset;
+        }
+
+        // A read may give less than asked before the end: read on
+        while(dwBytesRead < dwBytesToRead)
+        {
+            int64_t n = (int64_t)peos_fread(fd, (BYTE *)pvBuffer + dwBytesRead, (size_t)(dwBytesToRead - dwBytesRead));
+            if(n < 0)
+            {
+                dwLastError = ERROR_CAN_NOT_COMPLETE;
+                return false;
+            }
+            if(n == 0)
+                break;
+            dwBytesRead += (DWORD)n;
+        }
+    }
+#endif
+
     // Increment the current file position by number of bytes read
     // If the number of bytes read doesn't match to required amount, return false
     pStream->Base.File.FilePos = ByteOffset + dwBytesRead;
@@ -326,6 +404,55 @@ static bool BaseFile_Write(TFileStream * pStream, ULONGLONG * pByteOffset, const
     }
 #endif
 
+#ifdef STORMLIB_PEOS
+    {
+        uint64_t fd = (uint64_t)(intptr_t)pStream->Base.File.hFile;
+
+        if(ByteOffset != pStream->Base.File.FilePos)
+        {
+            // Past the end: PeOS seeks only inside a file, so the gap is filled
+            if(ByteOffset > pStream->Base.File.FileSize)
+            {
+                static const BYTE zeros[4096] = {0};
+                ULONGLONG at = pStream->Base.File.FileSize;
+                if((int64_t)peos_fseek(fd, (size_t)at) < 0)
+                {
+                    dwLastError = ERROR_CAN_NOT_COMPLETE;
+                    return false;
+                }
+                while(at < ByteOffset)
+                {
+                    size_t n = (ByteOffset - at) < sizeof(zeros) ? (size_t)(ByteOffset - at) : sizeof(zeros);
+                    if((int64_t)peos_fwrite(fd, zeros, n) != (int64_t)n)
+                    {
+                        dwLastError = ERROR_DISK_FULL;
+                        return false;
+                    }
+                    at += n;
+                }
+                pStream->Base.File.FileSize = at;
+            }
+            else if((int64_t)peos_fseek(fd, (size_t)ByteOffset) < 0)
+            {
+                dwLastError = ERROR_CAN_NOT_COMPLETE;
+                return false;
+            }
+            pStream->Base.File.FilePos = ByteOffset;
+        }
+
+        while(dwBytesWritten < dwBytesToWrite)
+        {
+            int64_t n = (int64_t)peos_fwrite(fd, (const BYTE *)pvBuffer + dwBytesWritten, (size_t)(dwBytesToWrite - dwBytesWritten));
+            if(n <= 0)
+            {
+                dwLastError = ERROR_DISK_FULL;
+                return false;
+            }
+            dwBytesWritten += (DWORD)n;
+        }
+    }
+#endif
+
     // Increment the current file position by number of bytes read
     pStream->Base.File.FilePos = ByteOffset + dwBytesWritten;
 
@@ -381,6 +508,28 @@ static bool BaseFile_Resize(TFileStream * pStream, ULONGLONG NewFileSize)
         return true;
     }
 #endif
+
+#ifdef STORMLIB_PEOS
+    {
+        // PeOS's files grow by writing; they shrink only when opened anew
+        // with truncate, which an open stream cannot do
+        if(NewFileSize > pStream->Base.File.FileSize)
+        {
+            ULONGLONG pos = pStream->Base.File.FilePos;
+            ULONGLONG last = NewFileSize - 1;
+            BYTE zero = 0;
+            if(!BaseFile_Write(pStream, &last, &zero, 1))
+                return false;
+            if((int64_t)peos_fseek((uint64_t)(intptr_t)pStream->Base.File.hFile, (size_t)pos) >= 0)
+                pStream->Base.File.FilePos = pos;
+            return true;
+        }
+        if(NewFileSize == pStream->Base.File.FileSize)
+            return true;
+        dwLastError = ERROR_NOT_SUPPORTED;
+        return false;
+    }
+#endif
 }
 
