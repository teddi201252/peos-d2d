+// SPDX-License-Identifier: GPL-3.0-or-later
+// PeOS only (tests/CMakeLists.txt adds it to every test there): PeOS hands no
+// environment to a program it starts, so when /games/diablo2 (PeOS's fixed
+// folder for the game's data) holds it, that is D2_MPQ_DIR, unless already set.
+#include <cstdlib>
+#include <filesystem>
+#include <system_error>
+
+namespace {
+const bool kMpqDirSet = [] {
+    std::error_code error;
+    return std::filesystem::exists("/games/diablo2/d2data.mpq", error) &&
+           ::setenv("D2_MPQ_DIR", "/games/diablo2", 0) == 0;
+}();
+}
diff --git a/tests/test_peos_mpq.cpp b/tests/test_peos_mpq.cpp
new file mode 100644
index 0000000..f72197a
--- /dev/null
+++ b/tests/test_peos_mpq.cpp
@@ -0,0 +1,103 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+// test-links: mpq
+// StormLib with no game data (written for the PeOS port, whose StormLib
+// reads and writes through PeOS's own file calls; runs anywhere): an MPQ made
+// here with a zlib, a bzip2 and a stored file, closed, opened again read-only
+// and read back byte for byte.
+#include <StormLib.h>
+
+#include <cstdint>
+#include <cstdio>
+#include <cstring>
+#include <filesystem>
+#include <string>
+#include <system_error>
+#include <vector>
+
+namespace fs = std::filesystem;
+
+static int failures = 0;
+static void check(bool ok, const char* what) {
+    std::printf("%s: %s\n", ok ? "OK" : "FAIL", what);
+    if (!ok) failures++;
+}
+
+struct Entry {
+    const char* name;
+    DWORD compression;   // 0: stored
+    std::vector<unsigned char> bytes;
+};
+
+static std::vector<unsigned char> pattern(std::size_t size, unsigned seed) {
+    std::vector<unsigned char> bytes(size);
+    std::uint32_t state = seed;
+    for (std::size_t index = 0; index < size; index++) {
+        state = state * 1103515245u + 12345u;
+        // runs of the same byte: something to compress
+        bytes[index] = static_cast<unsigned char>((index / 64) % 7 == 0 ? state >> 24 : (index / 512) & 0xff);
+    }
+    return bytes;
+}
+
+int main() {
+    std::error_code error;
+    fs::path dir = fs::temp_directory_path(error);
+    if (error) dir = ".";
+    const fs::path archive = dir / "d2d_test_peos.mpq";
+    fs::remove(archive, error);
+
+    std::vector<Entry> entries = {
+        { "data\\zlib.bin", MPQ_COMPRESSION_ZLIB, pattern(300000, 1) },
+        { "data\\bzip2.bin", MPQ_COMPRESSION_BZIP2, pattern(150000, 2) },
+        { "data\\stored.txt", 0, {} },
+    };
+    const std::string text = "Stay awhile and listen.\n";
+    entries[2].bytes.assign(text.begin(), text.end());
+
+    HANDLE mpq = nullptr;
+    check(SFileCreateArchive(archive.string().c_str(), MPQ_CREATE_ARCHIVE_V2 | MPQ_CREATE_LISTFILE, 16, &mpq),
+          "SFileCreateArchive");
+    if (!mpq) return 1;
+    for (const auto& entry : entries) {
+        HANDLE file = nullptr;
+        const DWORD flags = entry.compression ? MPQ_FILE_COMPRESS : 0;
+        bool ok = SFileCreateFile(mpq, entry.name, 0, DWORD(entry.bytes.size()), 0, flags, &file);
+        ok = ok && SFileWriteFile(file, entry.bytes.data(), DWORD(entry.bytes.size()), entry.compression);
+        ok = ok && SFileFinishFile(file);
+        check(ok, entry.name);
+    }
+    check(SFileCloseArchive(mpq), "SFileCloseArchive");
+    check(fs::is_regular_file(archive) && fs::file_size(archive) > 0, "the archive is on disk");
+
+    mpq = nullptr;
+    check(SFileOpenArchive(archive.string().c_str(), 0, STREAM_FLAG_READ_ONLY, &mpq), "SFileOpenArchive, read-only");
+    if (!mpq) return 1;
+    for (const auto& entry : entries) {
+        HANDLE file = nullptr;
+        if (!SFileOpenFileEx(mpq, entry.name, SFILE_OPEN_FROM_MPQ, &file)) {
+            check(false, "SFileOpenFileEx");
+            continue;
+        }
+        const DWORD size = SFileGetFileSize(file, nullptr);
+        std::vector<unsigned char> back(size);
+        DWORD read = 0;
+        const bool ok = SFileReadFile(file, back.data(), size, &read, nullptr);
+        DWORD compressed = 0;
+        SFileGetFileInfo(file, SFileInfoCompressedSize, &compressed, sizeof(compressed), nullptr);
+        SFileCloseFile(file);
+        check(ok && read == entry.bytes.size() && back == entry.bytes, "read back byte for byte");
+        if (entry.compression) check(compressed < size, "stored smaller than it is (compressed)");
+    }
+    SFILE_FIND_DATA found;
+    int listed = 0;
+    if (HANDLE find = SFileFindFirstFile(mpq, "data\\*", &found, nullptr)) {
+        do listed++;
+        while (SFileFindNextFile(find, &found));
+        SFileFindClose(find);
+    }
+    check(listed == 3, "the listfile names the three");
+    check(SFileCloseArchive(mpq), "closed again");
+    fs::remove(archive, error);
+    if (failures == 0) std::printf("test_peos_mpq: ok\n");
+    return failures == 0 ? 0 : 1;
+}
