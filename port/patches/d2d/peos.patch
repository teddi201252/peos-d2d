diff --git a/components/net/tcp_peos.cpp b/components/net/tcp_peos.cpp
new file mode 100644
index 0000000..b72131b
--- /dev/null
+++ b/components/net/tcp_peos.cpp
@@ -0,0 +1,130 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+// tcp.hpp on PeOS (d2decomped port plan, phase 7): a connection over PeOS's
+// own TCP (peos/net.h, netd), to join a game.exe host on the LAN. A host
+// name is resolved by netd's DNS. Listening (d2proxy's TcpListener) waits
+// for netd to listen: it says so.
+#include "tcp.hpp"
+
+#include <peos/net.h>
+
+#include <cstring>
+#include <memory>
+#include <utility>
+
+namespace d2d::net {
+
+namespace {
+
+// What socket_ holds on PeOS: netd's connection and the bytes of a piece read
+// in part (net_tcp_read keeps them for the next call).
+struct Conn {
+    std::int64_t conn = -1;
+    net_tcp_reader_t reader{};
+};
+
+auto conn_of(std::intptr_t socket) -> Conn* { return reinterpret_cast<Conn*>(socket); }
+
+auto close_conn(std::intptr_t socket) -> void {
+    if (socket == -1) return;
+    std::unique_ptr<Conn> owned(conn_of(socket));
+    if (owned->conn >= 0) (void)peos_fclose(static_cast<std::uint64_t>(owned->conn));
+}
+
+auto net_error(std::int64_t code) -> std::string {
+    switch (code) {
+        case NET_ERR_TIMEOUT: return "timed out";
+        case NET_ERR_REFUSED: return "refused";
+        case NET_ERR_NO_ADDRESS: return "no network address yet";
+        case NET_ERR_UNREACHABLE: return "host unreachable";
+        case NET_ERR_NOT_FOUND: return "no such host";
+        case NET_ERR_BUSY: return "too many connections";
+        case NET_ERR_DENIED: return "not allowed (the app needs the network capability)";
+        default: return "network error " + std::to_string(code);
+    }
+}
+
+constexpr std::uint64_t kNsPerMs = 1'000'000ull;
+
+} // namespace
+
+auto TcpConnection::connect(const std::string& host, std::uint16_t port, int timeout_ms) -> std::expected<TcpConnection, std::string> {
+    std::uint8_t ip[4] = {};
+    const std::uint64_t timeout_ns = std::uint64_t(timeout_ms > 0 ? timeout_ms : 0) * kNsPerMs;
+    if (net_parse_ipv4(host.c_str(), ip) != 0) {
+        const int resolved = net_resolve(host.c_str(), ip, timeout_ns);
+        if (resolved != NET_OK) return std::unexpected(host + ": " + net_error(resolved));
+    }
+    const std::int64_t conn = net_tcp_connect(ip, port, timeout_ns);
+    if (conn < 0) return std::unexpected("connect " + host + ":" + std::to_string(port) + ": " + net_error(conn));
+    auto owned = std::make_unique<Conn>();
+    owned->conn = conn;
+    net_tcp_reader_init(&owned->reader, conn);
+    return TcpConnection(reinterpret_cast<std::intptr_t>(owned.release()));
+}
+
+TcpConnection::TcpConnection(TcpConnection&& other) noexcept : socket_(std::exchange(other.socket_, -1)) {}
+
+auto TcpConnection::operator=(TcpConnection&& other) noexcept -> TcpConnection& {
+    if (this != &other) {
+        close_conn(socket_);
+        socket_ = std::exchange(other.socket_, -1);
+    }
+    return *this;
+}
+
+TcpConnection::~TcpConnection() { close_conn(socket_); }
+
+auto TcpConnection::send(std::span<const std::uint8_t> bytes) -> std::expected<void, std::string> {
+    if (socket_ == -1) return std::unexpected("send: not connected");
+    if (bytes.empty()) return {};
+    const std::int64_t sent = net_tcp_send(conn_of(socket_)->conn, bytes.data(), bytes.size());
+    if (sent != std::int64_t(bytes.size())) return std::unexpected("send: connection broken");
+    return {};
+}
+
+auto TcpConnection::receive(int timeout_ms) -> std::expected<d2gs::Bytes, std::string> {
+    if (socket_ == -1) return std::unexpected("receive: not connected");
+    Conn* c = conn_of(socket_);
+    d2gs::Bytes out;
+    std::uint8_t piece[PEOS_CHANNEL_MSG_MAX];
+    // the first wait is the caller's; then whatever is there already
+    std::uint64_t wait_ns = std::uint64_t(timeout_ms > 0 ? timeout_ms : 0) * kNsPerMs;
+    for (;;) {
+        const std::int64_t got = net_tcp_read(&c->reader, piece, sizeof piece, wait_ns);
+        if (got == NET_ERR_TIMEOUT) break;
+        if (got == 0) {
+            if (!out.empty()) break;   // the end comes after what arrived with it
+            return std::unexpected("the host closed the connection");
+        }
+        if (got < 0) {
+            if (!out.empty()) break;
+            return std::unexpected("receive: connection broken");
+        }
+        out.insert(out.end(), piece, piece + got);
+        wait_ns = 0;
+        if (out.size() >= 64 * 1024) break;   // a frame's worth: the rest at the next call
+    }
+    return out;
+}
+
+auto TcpListener::listen(std::uint16_t, const std::string&) -> std::expected<TcpListener, std::string> {
+    return std::unexpected("PeOS: netd cannot listen yet (joining a host works)");
+}
+TcpListener::TcpListener(TcpListener&& other) noexcept : socket_(std::exchange(other.socket_, -1)) {}
+auto TcpListener::operator=(TcpListener&& other) noexcept -> TcpListener& {
+    socket_ = std::exchange(other.socket_, -1);
+    return *this;
+}
+TcpListener::~TcpListener() = default;
+auto TcpListener::accept(int, std::string*) -> std::expected<std::optional<TcpConnection>, std::string> {
+    return std::unexpected("PeOS: netd cannot listen yet");
+}
+
+auto own_address() -> std::string {
+    peos_netcfg_t cfg{};
+    if (net_config_get(&cfg) != NET_OK) return "0.0.0.0";
+    return std::to_string(cfg.ip[0]) + "." + std::to_string(cfg.ip[1]) + "." + std::to_string(cfg.ip[2]) + "." +
+           std::to_string(cfg.ip[3]);
+}
+
+} // namespace d2d::net
