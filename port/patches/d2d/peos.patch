diff --git a/apps/d2d/peos/find_data.hpp b/apps/d2d/peos/find_data.hpp
new file mode 100644
index 0000000..670547a
--- /dev/null
+++ b/apps/d2d/peos/find_data.hpp
@@ -0,0 +1,43 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+// PeOS only: where the game's MPQs are (PeOS 0.16.0). First the folder d2d.app
+// is given (--data /games/diablo2); if d2data.mpq is not there, the USB sticks
+// PeOS mounts by itself on /media1 ... /media4: the top of each, then each
+// folder right under it ("diablo2", "Diablo II Complete Edition", ...).
+// The app's manifest grants /media1 ... /media4 for reading.
+//
+// TODO(PeOS): when Curiosity has a global file picker (a folder chooser any
+// app can open), this search gives way to asking once: "where is Diablo II?",
+// the folder kept in d2d.cfg (`data =`), and the no-data page's button opens
+// the picker. Until then, a stick is searched every time the game starts.
+#pragma once
+
+#include <filesystem>
+#include <string>
+#include <system_error>
+
+namespace d2d::peos_port {
+
+inline bool has_mpqs(const std::filesystem::path& dir) {
+    std::error_code ec;
+    return std::filesystem::is_regular_file(dir / "d2data.mpq", ec);
+}
+
+// The folder with d2data.mpq: preferred if it has it, else the first found on
+// a stick; preferred again (the no-data page follows) if none.
+inline std::string find_data(const std::string& preferred) {
+    namespace fs = std::filesystem;
+    if (preferred.empty() || has_mpqs(preferred)) return preferred;
+    for (int n = 1; n <= 4; ++n) {
+        const fs::path stick = "/media" + std::to_string(n);
+        std::error_code ec;
+        if (!fs::is_directory(stick, ec)) continue;
+        if (has_mpqs(stick)) return stick.string();
+        for (fs::directory_iterator it(stick, ec), end; !ec && it != end; it.increment(ec)) {
+            std::error_code dec;
+            if (it->is_directory(dec) && has_mpqs(it->path())) return it->path().string();
+        }
+    }
+    return preferred;
+}
+
+}  // namespace d2d::peos_port
diff --git a/apps/d2d/peos/no_data.hpp b/apps/d2d/peos/no_data.hpp
new file mode 100644
index 0000000..994dbd0
--- /dev/null
+++ b/apps/d2d/peos/no_data.hpp
@@ -0,0 +1,66 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+// PeOS only: the window d2d.app shows when the game's MPQs are neither in
+// /games/diablo2 nor on a stick (d2decomped port, phase 6; peos/find_data.hpp).
+// Where they go, in the language Starlight has (the bundle's
+// resources/<lang>/String.lang), and OK, which closes the app. A Starlight page (SLUI), not
+// the game's: nothing of the game is loaded.
+#pragma once
+
+#include <peos/peos.h>
+#include <peos/starlight_ui.h>
+
+#include <cstdint>
+#include <string>
+
+namespace d2d::peos_port {
+
+inline void show_no_data() {
+    constexpr std::uint32_t kOk = 1;
+    constexpr std::uint32_t kLines = 10;
+    std::uint32_t w = 0, h = 0;
+    bool dirty = true, done = false;
+    const auto draw = [&] {
+        slui_begin_frame();
+        if (w && h) {
+            slui_rect_theme(0, 0, w, h, SLUI_COLOR_BG_CANVAS);
+            const std::uint32_t left = 32;
+            std::uint32_t y = 28;
+            slui_set_font_px(24);
+            slui_label_theme(left, y, SLUI_COLOR_TEXT_PRIMARY, slui_text("nodata.title"));
+            slui_set_font_px(16);
+            y += 52;
+            for (std::uint32_t i = 1; i <= kLines; ++i) {
+                const std::string key = "nodata." + std::to_string(i);
+                // a gap before the steps and before the files' names
+                if (i == 5 || i == 9) y += 14;
+                slui_label_theme(left, y, i >= 6 && i <= 8 ? SLUI_COLOR_TEXT_PRIMARY : SLUI_COLOR_TEXT_SECONDARY,
+                                 slui_text(key.c_str()));
+                y += 26;
+            }
+            const std::uint32_t bw = 120, bh = 40;
+            slui_button_primary(kOk, w > bw + left ? w - bw - left : 0, h > bh + 24 ? h - bh - 24 : 0, bw, bh, 1,
+                                slui_text("nodata.ok"));
+            slui_focus(kOk);
+        }
+        slui_end_frame();
+        dirty = false;
+    };
+    draw();   // says hello: Starlight answers with the size and the language
+    while (!done) {
+        slui_event_t ev;
+        while (slui_poll_event(&ev)) {
+            if (ev.type == SLUI_EVENT_RESIZE || ev.type == SLUI_EVENT_LANGUAGE) {
+                slui_viewport(&w, &h);
+                dirty = true;
+            } else if (ev.type == SLUI_EVENT_BUTTON && ev.id == kOk) {
+                done = true;
+            } else if (ev.type == SLUI_EVENT_KEY_DOWN && (ev.keycode == PEOS_KEY_ENTER || ev.keycode == PEOS_KEY_ESC)) {
+                done = true;
+            }
+        }
+        if (dirty && !done) draw();
+        peos_sleep(2);
+    }
+}
+
+}  // namespace d2d::peos_port
